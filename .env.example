# Public site URL (no trailing slash) — used for canonical URLs, sitemap, OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (Resend). Leave RESEND_API_KEY empty in dev:
# the /api/contact route then logs the payload instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@viesa-automations.nl
CONTACT_FROM_EMAIL=website@viesa-automations.nl

# Optional: also forward submissions to an n8n webhook
N8N_CONTACT_WEBHOOK_URL=

# Cal.com booking ("Vraag gratis audit aan"). LINK is "<handle>/<event-slug>".
NEXT_PUBLIC_CALCOM_LINK=tom-en-joep-viesa-ufyeh6/gratis-audit
NEXT_PUBLIC_CALCOM_NAMESPACE=gratis-audit
# Signing secret for the Cal.com booking webhook (/api/cal/webhook). Leave empty
# to skip signature verification in local dev.
CALCOM_WEBHOOK_SECRET=

# Optional: Cloudflare Turnstile (spam protection). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
